#!/usr/bin/env bash

set -euo pipefail

wt_bin="${WORKTRUNK_BIN:-wt}"

if ! command -v jq >/dev/null 2>&1; then
  echo "worktrunk-cleanup requires jq" >&2
  exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "worktrunk-cleanup requires gh" >&2
  exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "worktrunk-cleanup requires fzf" >&2
  exit 1
fi

worktrees_json="$($wt_bin list --format json)"
merged_prs_json="$(gh pr list --state merged --limit 200 --json closedAt,headRefName,mergedAt,number,state,title,url)"
closed_prs_json="$(gh pr list --state closed --limit 200 --json closedAt,headRefName,mergedAt,number,state,title,url)"

candidates="$(
jq -rn \
  --argjson worktrees "$worktrees_json" \
  --argjson merged_prs "$merged_prs_json" \
  --argjson closed_prs "$closed_prs_json" '
  ($merged_prs + $closed_prs | map({key: .headRefName, value: .}) | from_entries) as $pr_by_branch
  | $worktrees.items[]
  | select((.worktree.main // false) | not)
  | select(.branch != null)
  | . as $row
  | $pr_by_branch[$row.branch] as $pr
  | select($pr != null)
  | [
      $row.worktree.path,
      $row.branch,
      ("#" + ($pr.number | tostring)),
      ($pr.state | ascii_downcase),
      (($pr.mergedAt // $pr.closedAt // "") | split("T")[0]),
      ($pr.title // "")
    ]
  | @tsv
')"

if [[ -z "$candidates" ]]; then
  echo "No worktrees with closed or merged PRs found."
  exit 0
fi

formatted_candidates="$(
printf '%s\n' "$candidates" | awk -F '\t' '
  {
    path[NR] = $1
    branch[NR] = $2
    pr[NR] = $3
    status[NR] = $4
    closed[NR] = $5
    title[NR] = $6
    if (length($2) > branch_width) branch_width = length($2)
    if (length($3) > pr_width) pr_width = length($3)
    if (length($4) > status_width) status_width = length($4)
    if (length($5) > closed_width) closed_width = length($5)
  }
  END {
    if (branch_width < length("Branch")) branch_width = length("Branch")
    if (pr_width < length("PR")) pr_width = length("PR")
    if (status_width < length("Status")) status_width = length("Status")
    if (closed_width < length("Closed")) closed_width = length("Closed")

    header = sprintf("%-*s  %-*s  %-*s  %-*s  %s", branch_width, "Branch", pr_width, "PR", status_width, "Status", closed_width, "Closed", "Title")
    printf "\t%s\t\t\t\n", header

    for (i = 1; i <= NR; i++) {
      display = sprintf("%-*s  %-*s  %-*s  %-*s  %s", branch_width, branch[i], pr_width, pr[i], status_width, status[i], closed_width, closed[i], title[i])
      printf "%s\t%s\t%s\t%s\n", path[i], display, branch[i], pr[i]
    }
  }
')"

selection="$(
printf '%s\n' "$formatted_candidates" | fzf \
  --multi \
  --delimiter='\t' \
  --with-nth=2 \
  --header-lines=1 \
  --header='Select closed or merged PR worktrees to remove' \
  --prompt='remove closed/merged > '
)" || exit $?

if [[ -z "$selection" ]]; then
  echo "No worktrees selected."
  exit 0
fi

count="$(printf '%s\n' "$selection" | sed '/^$/d' | wc -l | tr -d ' ')"
echo "Will run 'wt remove' for $count worktree(s):"
printf '%s\n' "$selection" | awk -F '\t' '{printf "  %s  %s  %s\n", $3, $4, $1}'

read -r -p "Continue? [y/N] " answer
case "$answer" in
  [yY]|[yY][eE][sS]) ;;
  *) echo "Cancelled."; exit 0 ;;
esac

printf '%s\n' "$selection" | while IFS=$'\t' read -r path _ branch pr; do
  [[ -n "$path" ]] || continue
  echo
  echo "==> Removing $branch ($pr) @ $path"
  "$wt_bin" remove "$branch"
done
