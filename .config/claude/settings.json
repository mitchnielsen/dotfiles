{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiSkills": false,
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Agent(*)",
      "Bash",
      "Edit(*)",
      "Read(*)",
      "Skill(*)",
      "WebFetch",
      "WebSearch",
      "Write(*)",
      "mcp__clickhouse",
      "mcp__incidentio",
      "mcp__linear",
      "mcp__prometheus"
    ],
    "deny": [
      "EnterWorktree"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/mitch/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cship"
  },
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "https://github\\.com/(?<owner>[\\w.-]+)/(?<repo>[\\w.-]+)/pull/(?<num>\\d+)",
      "url": "https://github.com/{owner}/{repo}/pull/{num}",
      "label": "{repo}#{num}"
    }
  ],
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "prefect-internal-skills@prefecthq-internal-skills": true,
    "typescript-lsp@claude-plugins-official": true,
    "visual-explainer@visual-explainer-marketplace": true
  },
  "extraKnownMarketplaces": {
    "prefecthq-internal-skills": {
      "source": {
        "source": "github",
        "repo": "prefecthq/internal-skills"
      }
    },
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      }
    },
    "incident-io-skills": {
      "source": {
        "source": "github",
        "repo": "incident-io/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "terminalProgressBarEnabled": false,
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754598531219
  }
}
