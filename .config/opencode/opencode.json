{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "terraform *": "ask",
      "rm *": "ask",
      "git *": "ask",
      "*": "allow"
    },
    "external_directory": {
      "~/code/github.com/**": "allow"
    },
    "mcp__clickhouse_*": "allow",
    "mcp__datadog_*": "allow",
    "mcp__linear_*": "allow",
    "mcp__incident.io_*": "allow"
  },
  "plugin": [
    "@datadog/opencode-plugin",
    "@plannotator/opencode@latest"
  ],
  "mcp": {
    "linear": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "incident.io": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.incident.io/mcp"
    }
  }
}
